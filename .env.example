# Copy to .env before running `docker compose up`.
# These values are for LOCAL DEMO ONLY — never reuse them anywhere real.

# Signs and verifies JWTs. Shared by auth-service and the gateway.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-separated origin allowlist enforced by the gateway.
CORS_ORIGIN=http://localhost:3000

# Fake delay (ms) added to product reads so the skeleton loaders are visible.
# Set to 0 to disable.
ARTIFICIAL_LATENCY_MS=350

LOG_LEVEL=info
